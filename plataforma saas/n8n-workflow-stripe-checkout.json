{
  "name": "NeuroOps: Gateway de Pagamento (Stripe API)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "neuroops-create-payment-intent",
        "options": {}
      },
      "id": "webhook-create-pi",
      "name": "Webhook (Criar PI)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 100, 200 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.stripe.com/v1/payment_intents",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "amount", "value": "={{ Math.round($json.body.priceAmount * 100) }}" },
            { "name": "currency", "value": "brl" },
            { "name": "receipt_email", "value": "={{ $json.body.customerEmail || '' }}" },
            { "name": "metadata[planName]", "value": "={{ $json.body.planName }}" },
            { "name": "metadata[planType]", "value": "={{ $json.body.planType }}" },
            { "name": "metadata[coupon]", "value": "={{ $json.body.coupon || 'none' }}" }
          ]
        },
        "options": {}
      },
      "id": "http-stripe-intent",
      "name": "Stripe: Criar Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 360, 200 ],
      "credentials": { "httpHeaderAuth": { "id": "YOUR_STRIPE_SECRET_CREDENTIAL", "name": "Stripe API Key" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"clientSecret\": \"{{ $json.client_secret }}\",\n  \"paymentIntentId\": \"{{ $json.id }}\"\n}",
        "options": {}
      },
      "id": "respond-pi",
      "name": "Retornar Cliente Secret",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 620, 200 ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "neuroops-validate-coupon",
        "options": {}
      },
      "id": "webhook-coupon",
      "name": "Webhook (Validar Cupom)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 100, 460 ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.stripe.com/v1/coupons/{{ $json.body.code }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "ignoreResponseCode": true
      },
      "id": "http-stripe-coupon",
      "name": "Stripe: Buscar Cupom",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 360, 460 ],
      "credentials": { "httpHeaderAuth": { "id": "YOUR_STRIPE_SECRET_CREDENTIAL", "name": "Stripe API Key" } }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [ { "value1": "={{ $json.error ? false : true }}", "value2": true } ]
        }
      },
      "id": "if-coupon-exists",
      "name": "Existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 560, 460 ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"valid\": true,\n  \"coupon\": {\n    \"percent_off\": {{ $json.percent_off || 0 }},\n    \"amount_off\": {{ $json.amount_off || 0 }}\n  }\n}",
        "options": {}
      },
      "id": "respond-coupon-ok",
      "name": "Retornar Desconto",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 820, 360 ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"valid\": false,\n  \"error\": \"Cupom inválido ou expirado\"\n}",
        "options": {}
      },
      "id": "respond-coupon-error",
      "name": "Retornar Erro",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 820, 560 ]
    }
  ],
  "connections": {
    "Webhook (Criar PI)": { "main": [ [ { "node": "Stripe: Criar Intent", "type": "main", "index": 0 } ] ] },
    "Stripe: Criar Intent": { "main": [ [ { "node": "Retornar Cliente Secret", "type": "main", "index": 0 } ] ] },
    "Webhook (Validar Cupom)": { "main": [ [ { "node": "Stripe: Buscar Cupom", "type": "main", "index": 0 } ] ] },
    "Stripe: Buscar Cupom": {
      "main": [
        [
          {
            "node": "Existe?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Existe?": {
      "main": [
        [ { "node": "Retornar Desconto", "type": "main", "index": 0 } ],
        [ { "node": "Retornar Erro", "type": "main", "index": 0 } ]
      ]
    }
  },
  "settings": {}
}
